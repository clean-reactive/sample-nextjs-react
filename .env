# Default values for local development. To use your own, create a git-ignored
# .env.local in the project root — its values override this file.
PERSISTENCE=in-file

# --- sqlite backend (dev:sqlite) ---
DATABASE_URL=file:sqlite.local.db
DATABASE_AUTH_TOKEN=local-dev-placeholder

# --- in-file backend (dev:in-file) ---
# JSON files the in-file repositories persist to (git-ignored via *.local.*).
IN_FILE_USERS_FILE=in-file-users.local.json
IN_FILE_TODOS_FILE=in-file-todos.local.json
